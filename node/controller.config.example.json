{
  "_comment": "Copy this to controller.config.json, fill in the GitHub App id and key path, and chmod 600 it. See README.md.",
  "pages_url": "https://<owner>.github.io/<repo>",
  "repo": "<owner>/<repo>",
  "app_id": 123456,
  "app_private_key_file": "~/.config/keiyoushi-monitor/app.pem",
  "proxy_host": "proxy",
  "proxy_port": 3128,
  "mem_limit": "1500m",
  "pids_limit": 256,
  "cpus": 2,
  "state_file": "node/.last_run_id",
  "verify_attestation": true,
  "skip_own_ip_lookup": false,
  "chrome_sandbox": false
}
